{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/coagent-provenance-gate.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pipeline-freshness-cap.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__evaluate_script",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp-publish-gate.mjs\""
          }
        ]
      }
    ]
  }
}
